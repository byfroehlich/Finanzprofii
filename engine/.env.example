# Supabase (Projekt-Einstellungen › API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Nutzer-ID von Mathias (Authentication › Users)
OWNER_ID=

# Ordner mit CLAUDE.md, REGELN.md, _Wissen/wissensregister.json (Kopie oder Sync des iCloud-Ordners)
WISSEN_DIR=/srv/zentrale/wissen
# Claude Code CLI (mit dem Abo angemeldet: `claude` einmal interaktiv starten)
CLAUDE_BIN=claude

# Web Push (einmalig erzeugen: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:name@example.org

# Abrufer – leer lassen = aus
SMOOBU_API_KEY=
SMOOBU_KONTO_ID=
QONTO_LOGIN=
QONTO_SECRET_KEY=
QONTO_KONTO_ID=
# FinTS: Zugangsdaten nie hier, sondern im Schlüsselbund/Passwort-Datei mit chmod 600
FINTS_CONFIG=/srv/zentrale/geheim/fints.json

# Mailversand nach Freigabe (SMTP des eigenen Postfachs)
SMTP_HOST=mail.gmx.net
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Sicherung
SICHERUNG_DIR=/srv/zentrale/sicherung
